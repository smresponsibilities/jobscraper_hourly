node_modules/
out/
*.log
.DS_Store
.env
.env.*

# ~9 MB of job IDs, rewritten every hour. It lives in the Actions cache, never in
# git — a full copy per commit would add gigabytes a year. If the cache is ever
# evicted, the run seeds itself from data/jobs.json and stays silent for one
# cycle. state/discover-cursor.json IS committed: it's tiny and the weekly
# Common Crawl sweep needs it to know which block to scan next.
state/seen.json
state/contact-sweep.json
state/leadership-sweep.json

# Per-board poll times and failure streaks — one entry per board, rewritten for
# up to BOARDS_PER_RUN of them every run. It exists precisely so companies.json
# stops carrying those two fields, so committing it here would just move the
# churn rather than remove it. Cache-only, same as seen.json; an eviction costs
# one degraded rotation and nothing else.
state/board-state.json

# Workday requisition id -> resolved real location, for postings whose list
# view only shows a placeholder count ("6 Locations"). Permanent per-id cache,
# not a rolling window — cheap to rebuild (one degraded run re-resolving
# everything from scratch) if the cache is ever evicted.
state/multiloc.json

# Real people's work addresses plus send/touch history. Lives in the PRIVATE
# outreach-data repo via publish-outreach.ts, never here — see that file's
# header. This entry exists because a local `npm run outreach` run writes it
# unconditionally; without the ignore, one `git add -A` on a dev machine would
# be enough to leak it into this public repo's history.
state/contacted.json

# Regenerated in one command (`npm run yc-domains -- India > state/yc-india.txt`)
# from a directory that changes weekly, so committing it would add churn without
# adding information — the durable record of what it resolved to is companies.json.
state/yc-*.txt

# Regenerated by `npm run oj-slugs` from a Common Crawl derived list that
# refreshes on its own schedule. Same reasoning as state/yc-*.txt: committing
# it adds churn without adding information, and companies.json is the record
# of what it actually resolved to.
state/oj-*.txt
state/outreach.pid
.claude/skills/wonder-pill/
.agents/skills/wonder-pill/

# Per-run state, same class as seen.json above: restored and saved through the
# Actions cache by hunt.yml, never through git. These five were simply never
# added to the list, so a local run left them showing as untracked additions.
state/outage.json
state/host-stats.json
state/reposts.json
state/board-volumes.json
state/volume-drops.json
